# Public browser API address, inlined by Expo at build time.
# Rebuild the web export after changing it. Keep AI/service secrets on backend.
EXPO_PUBLIC_API_URL=http://localhost:8000
# Real hosted login: public project URL and anon/publishable key only.
# Never put the Supabase service-role key or JWT secret in frontend variables.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
