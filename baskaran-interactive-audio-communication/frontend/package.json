{
  "name": "voicelearn-frontend",
  "version": "0.2.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/start-web.cjs",
    "web": "node scripts/start-web.cjs",
    "build:css": "node scripts/build-css.cjs",
    "build": "npm run build:css && expo export --platform web",
    "build:web": "npm run build",
    "start": "node scripts/serve-web.cjs",
    "lint": "eslint src App.web.tsx --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:web": "playwright test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.2",
    "@supabase/supabase-js": "^2.117.3",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "expo": "~57.0.28",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-web": "~0.21.2",
    "react-router-dom": "^7.9.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^20",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.0",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "postcss": "^8",
    "tailwindcss": "^3.4.13",
    "typescript": "^5"
  }
}
