SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_LOCALLY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_LOCALLY
SUPABASE_JWT_SECRET=REPLACE_LOCALLY
ALLOWED_ORIGINS=["https://voicelearn-audio.vercel.app"]
MAX_UPLOAD_MB=20
ACTIONS_ENABLED=true
CLOUD_USER_STORAGE=true
ACTIONS_PROVIDER=openclaw_mcp
ACTIONS_MAX_DOCUMENT_CHARS=12000
ACTIONS_TIMEOUT_SECONDS=600
ACTIONS_SECTIONED_ENABLED=true
ACTIONS_SECTIONED_TIMEOUT_SECONDS=1800
OPENCLAW_AGENT_ID=voicelearn-actions
OPENCLAW_GATEWAY_TOKEN=GENERATE_ON_SERVER
ACTIONS_BRIDGE_SECRET=GENERATE_ON_SERVER
USE_ENGLISH_TTS=true
USE_TAMIL_TTS=true
USE_DIRECT_MULTILINGUAL_GEMMA=true
