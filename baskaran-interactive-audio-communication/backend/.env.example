# ── Supabase ────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── ChromaDB ─────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=documents_bge_m3

# ── Modal endpoints (fill after `modal deploy`) ──────────
MODAL_WHISPER_URL=
MODAL_INDIC_STT_URL=        # Fill after: modal deploy backend/modal_endpoints/indic_stt.py
MODAL_PROMPT_ENHANCER_URL=
MODAL_RAG_GENERATOR_URL=
MODAL_LOCALIZER_URL=
MODAL_TTS_URL=

# ── TEMPORARY Sinhala VITS TTS test (dev-only; isolated from RAG/ASR) ─────
# Deploy: modal deploy backend/modal_endpoints/sinhala_vits_tts.py
# Modal prints two URLs: SinhalaVITSTTS.synthesize and SinhalaVITSTTS.romanize.
# Keep disabled unless evaluating the /api/v1/test/sinhala-tts page.
USE_SINHALA_TTS_TEST=false
MODAL_SINHALA_VITS_TTS_URL=
MODAL_SINHALA_VITS_TTS_ROMANIZE_URL=
# From the same `modal deploy backend/modal_endpoints/rag_generator.py` output:
# RAGGenerator.phonetic_transliterate. Keep blank to fall back safely to raw English.
MODAL_SINHALA_PHONETICS_URL=
SINHALA_PHONETICS_CACHE_PATH=data/sinhala_tts_phonetics.sqlite3

# ── Modal auth (from modal.com dashboard) ────────────────
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ── App ──────────────────────────────────────────────────
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000"]
MAX_UPLOAD_MB=20
DOCUMENT_INGESTION_TIMEOUT_SECONDS=300
SUPABASE_REQUEST_TIMEOUT_SECONDS=10
LOCAL_DOCUMENT_STORE_PATH=local_documents

# ── Modal BGE Retrieval Models ───────────────────────────
# Move BGE-M3 embedding + reranker to Modal GPU for lower latency.
# Steps:
#   1. modal deploy backend/modal_endpoints/bge_retrieval.py
#   2. Copy the two endpoint URLs printed by modal deploy into the vars below.
#   3. Set USE_MODAL_RETRIEVAL_MODELS=true and restart the backend.
# Keep false to use local CPU (safe default for development).
USE_MODAL_RETRIEVAL_MODELS=false
MODAL_BGE_EMBED_URL=    # BGEEmbedder /embed  — fill after modal deploy
MODAL_BGE_RERANK_URL=   # BGEReranker /rerank — fill after modal deploy

# ── Tamil-only TTS (AI4Bharat Indic Parler-TTS on Modal A10G) ──────────
# Deploy: modal deploy backend/modal_endpoints/tamil_parler_tts.py
# Then set USE_TAMIL_TTS=true and fill MODAL_TAMIL_TTS_URL.
# Keep false until deployed — Tamil text answers still work without TTS.
USE_TAMIL_TTS=false
MODAL_TAMIL_TTS_URL=    # TamilParlerTTS /synthesize — fill after modal deploy

# ── TEMPORARY Tamil TTS Test (isolated from RAG pipeline) ──────────────
# Enables POST /api/v1/test/tamil-tts for manual TTS testing.
# MODAL_TAMIL_TTS_URL above is shared — no separate URL needed.
# Keep USE_TAMIL_TTS=false while testing so RAG→TTS auto-trigger is off.
# Set USE_TAMIL_TTS_TEST=false (or remove) after testing is complete.
USE_TAMIL_TTS_TEST=false

# Used only by mixed Tamil + English TTS to better match IndicF5's supplied
# female Tamil prompt. Pure English continues to use its existing default.
MIXED_ENGLISH_TTS_DESCRIPTION="A clear, warm adult female English speaker with a soft, natural voice, moderate pitch, calm conversational delivery, moderate speaking speed, gentle energy, natural pauses, and clean studio-quality audio."
