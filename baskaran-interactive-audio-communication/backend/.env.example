# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Document index and retrieval
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=documents_bge_m3
USE_MODAL_RETRIEVAL_MODELS=false
MODAL_BGE_EMBED_URL=
MODAL_BGE_RERANK_URL=

# Final ASR routing
MODAL_WHISPER_URL=
MODAL_INDIC_STT_URL=
MODAL_SINHALA_ASR_URL=

# Shared RAG and language services
MODAL_TRANSCRIPT_CORRECTOR_URL=
MODAL_RAG_GENERATOR_URL=
MODAL_LOCALIZER_URL=
# Temporary latency experiment; false restores Gemma English -> Localizer.
USE_DIRECT_MULTILINGUAL_GEMMA=true

# Final TTS routing
USE_ENGLISH_TTS=true
# Deploy backend/modal_endpoints/english_kokoro_tts.py and paste its URL here.
MODAL_ENGLISH_KOKORO_TTS_URL=
ENGLISH_TTS_VOICE=af_heart
ENGLISH_TTS_SPEED=1.0
USE_TAMIL_TTS=true
MODAL_INDIC_PARLER_MIXED_TTS_URL=
MODAL_SINHALA_VITS_TTS_URL=

# Modal authentication
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Application
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002"]
MAX_UPLOAD_MB=20
DOCUMENT_INGESTION_TIMEOUT_SECONDS=300
SUPABASE_REQUEST_TIMEOUT_SECONDS=10
LOCAL_DOCUMENT_STORE_PATH=local_documents
