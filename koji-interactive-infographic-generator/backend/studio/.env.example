# Local development only. Configure hosted secrets in Render's environment.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STUDIO_STORAGE_BUCKET=koji-generations
CORS_ORIGINS=http://localhost:8081,http://localhost:8091
STUDIO_MAX_ACTIVE_JOBS=3
# Supabase Free currently limits individual uploads to 50 MB.
STUDIO_MAX_ASSET_MB=50
PROMPT_AGENT_URL=
IMAGE_AGENT_URL=
SKETCH_AGENT_URL=
INTERACTIVE_AGENT_URL=
EVAL_AGENT_URL=
THREED_AGENT_URL=
ORCHESTRATOR_URL=
