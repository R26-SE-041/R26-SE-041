[Unit]
Description=Koji durable model job worker
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/koji/backend
EnvironmentFile=/home/ubuntu/koji/backend/.env
ExecStart=/home/ubuntu/koji/backend/.venv/bin/python -m studio.worker
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
