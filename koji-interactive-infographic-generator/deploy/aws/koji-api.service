[Unit]
Description=Koji Studio API
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/koji/backend
EnvironmentFile=/home/ubuntu/koji/backend/.env
ExecStart=/home/ubuntu/koji/backend/.venv/bin/python -m uvicorn studio.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
