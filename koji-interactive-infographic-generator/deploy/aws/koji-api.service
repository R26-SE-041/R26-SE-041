[Unit]
Description=Koji Studio API
After=network-online.target
Wants=network-online.target

[Service]
User=koji
Group=koji
WorkingDirectory=/opt/koji/current/backend
EnvironmentFile=/etc/koji/studio.env
ExecStart=/opt/koji/current/venv/bin/python -m uvicorn studio.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
