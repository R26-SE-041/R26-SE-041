APP_ENV=production
DEBUG=false
ALLOWED_ORIGINS=https://your-quiz.vercel.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Copy the Session pooler URI from Supabase > Connect; keep sslmode=require.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_MAX=10
CHECKPOINT_DB_PATH=/app/db/checkpoints.db
CHROMA_PERSIST_DIR=/app/db/chroma_v6
SQLITE_DB_PATH=/app/db/sessions.db
MODAL_ENDPOINT_URL=https://nisharahtheva--nishy-qwen-adaptive-quiz-web-endpoint.modal.run/generate
MODAL_API_KEY=
MODAL_REQUEST_TIMEOUT_SEC=660
# Allow the serverless GPU to cold-start for topics needing remote generation.
QUIZ_GENERATION_BUDGET_SEC=120
MODAL_MAX_NEW_TOKENS=180
WEAK_TOPIC_THRESHOLD=0.60
GROUNDING_THRESHOLD=0.55
HINT_RAG_MIN_SIMILARITY=0.45
