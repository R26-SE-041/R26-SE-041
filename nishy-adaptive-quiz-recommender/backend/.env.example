SQLITE_DB_PATH=./db/sessions.db
# Leave empty for local SQLite; use Supabase Session pooler (port 5432) on EC2.
# URL-encode special characters in the password. Never put this on Vercel.
DATABASE_URL=
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000
CHECKPOINT_DB_PATH=./db/checkpoints.db
DB_POOL_MAX=10
CHROMA_PERSIST_DIR=./db/chroma_v6
MODAL_ENDPOINT_URL=https://nisharahtheva--nishy-qwen-adaptive-quiz-web-endpoint.modal.run/generate
MODAL_API_KEY=
MODAL_REQUEST_TIMEOUT_SEC=45
QUIZ_GENERATION_BUDGET_SEC=15
MODAL_HEALTH_CACHE_SEC=30
MODAL_FAILURE_COOLDOWN_SEC=30
EMBEDDING_CACHE_SIZE=2048
PRELOAD_EMBEDDINGS=true
MODAL_MAX_NEW_TOKENS=180
WEAK_TOPIC_THRESHOLD=0.60
GROUNDING_THRESHOLD=0.55
HINT_RAG_MIN_SIMILARITY=0.45

# Required for protected API routes, including local development.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
