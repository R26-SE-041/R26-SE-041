# -----------------------------------------------------------------------
# Modal.com endpoint URLs (set after deploying modal_functions/)
# -----------------------------------------------------------------------
SRCNN_MODAL_URL=https://your-workspace--srcnn-super-resolution-srcnnenhancer-enhance.modal.run
TROCR_MODAL_URL=https://your-workspace--sinhala-trocr-ocr-service-sinhalatrocrextractor-extract-text.modal.run
TROCR_LINES_MODAL_URL=https://your-workspace--sinhala-trocr-ocr-service-sinhalatrocrextractor-extract-lines.modal.run

# -----------------------------------------------------------------------
# FastAPI settings
# -----------------------------------------------------------------------
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Max upload size in bytes (default: 10 MB)
MAX_UPLOAD_BYTES=10485760

# Production: Supabase project settings > API > legacy service_role key.
# Keep this key on EC2 only. Never use an EXPO_PUBLIC_ prefix for it.
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_FEEDBACK_BUCKET=ocr-feedback
SUPABASE_HISTORY_BUCKET=ocr-history

# Optional translation endpoint
TRANSLATE_MODAL_URL=
