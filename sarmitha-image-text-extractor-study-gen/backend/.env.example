# -----------------------------------------------------------------------
# Modal.com endpoint URLs (set after deploying modal_functions/)
# -----------------------------------------------------------------------
SRCNN_MODAL_URL=https://your-workspace--srcnn-super-resolution-srcnnenhancer-enhance.modal.run
TROCR_MODAL_URL=https://your-workspace--trocr-ocr-service-trocextractor-extract-text.modal.run

# -----------------------------------------------------------------------
# FastAPI settings
# -----------------------------------------------------------------------
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Max upload size in bytes (default: 10 MB)
MAX_UPLOAD_BYTES=10485760
